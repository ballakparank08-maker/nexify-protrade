# Backend server
PORT=4000

# Private admin URL path (obscurity only; not a security boundary)
ADMIN_LOGIN_PATH=/secure-admin-login

# Frontend route used to render the admin login screen.
# Keep this in sync with ADMIN_LOGIN_PATH.
VITE_ADMIN_LOGIN_PATH=/secure-admin-login

# Comma-separated normalized allowlist for admin dashboard access.
# Admin users must have role=admin in backend storage AND be listed here.
ADMIN_ALLOWED_EMAILS=admin@example.com

# Optional one-time bootstrap placeholders (do not commit real credentials)
ADMIN_BOOTSTRAP_EMAIL=replace-with-admin-email@example.com
ADMIN_BOOTSTRAP_PASSWORD=replace-with-strong-password
